{
  "repository": "diegorramos/skills-registry",
  "branch": "main",
  "agents": {
    "opencode": {
      "name": "OpenCode",
      "skill_dir": ".opencode/agents",
      "file_pattern": "{slug}.md",
      "frontmatter_fields": {
        "description": { "required": true },
        "mode": { "default": "subagent", "values": ["primary", "subagent"] }
      }
    },
    "devin": {
      "name": "Devin",
      "skill_dir": ".devin/skills/{slug}",
      "file_pattern": "SKILL.md",
      "frontmatter_fields": {
        "name": { "required": true },
        "description": { "required": true },
        "triggers": { "default": ["user", "model"] },
        "subagent": { "default": true },
        "allowed-tools": { "default": ["read", "grep", "glob", "write"] }
      }
    },
    "claude": {
      "name": "Claude Code",
      "skill_dir": ".claude/skills/{slug}",
      "file_pattern": "SKILL.md",
      "frontmatter_fields": {
        "name": { "required": true },
        "description": { "required": true }
      }
    },
    "openclaw": {
      "name": "OpenClaw",
      "skill_dir": ".openclaw/workspace/skills/{slug}",
      "file_pattern": "SKILL.md",
      "frontmatter_fields": {
        "name": { "required": true },
        "description": { "required": true }
      }
    }
  },
  "skills": [
